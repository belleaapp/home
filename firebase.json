{
  "hosting": {
    "site": "bellea-store",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "!.well-known/**"],
    "headers": [
      { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }] }
    ]
  }
}
